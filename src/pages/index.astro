---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PostGrid from '../components/PostGrid.astro';
import LinkedInFeed from '../components/LinkedInFeed.astro';
import AboutClosing from '../components/AboutClosing.astro';
import { listedPosts } from '../lib/posts';
import { website } from '../lib/structuredData';

// The KI-Radar series has its own page (/ki-radar) and is not listed here.
const posts = await listedPosts();
const [latest, ...rest] = posts;
---
<Layout structuredData={website(Astro.site!.href)} ogImage={latest?.data.cover}>
  {latest && <Hero latest={latest} />}
  <PostGrid posts={rest} limit={6} eyebrow="Neueste Beiträge" heading="Frisch aus dem Backlog." more={{ href: '/beitraege', label: `Weitere Beiträge (${posts.length}) →` }} />
  <LinkedInFeed />
  <AboutClosing />
</Layout>
