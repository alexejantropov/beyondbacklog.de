---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Stroke from '../components/ui/Stroke.astro';
import NewsletterForm from '../components/ui/NewsletterForm.astro';
import { site } from '../data/site';

const newsletterAlert =
  'hidden rounded-control border border-accent/40 bg-tint px-5 py-3 text-sm font-semibold target:block';
---
<Layout title={`Newsletter abonnieren | ${site.name}`} description={`${site.name} als Newsletter: ${site.tagline} Kostenlos, unregelmäßig, jederzeit abbestellbar.`}>
  <section class="container-bb section-y">
    <div class="mx-auto flex max-w-[640px] flex-col gap-6">
      <Eyebrow>Newsletter</Eyebrow>
      <h1 class="headline text-h1">{site.newsletterClaim.start} <Stroke>{site.newsletterClaim.highlight}</Stroke>.</h1>
      <p class="text-lead text-ink/72">{site.tagline} Erfahrungen und Learnings aus 20 Jahren im Game.</p>
      <div id="ungueltig" class={newsletterAlert} role="alert">Bitte gib eine gültige E-Mail-Adresse ein.</div>
      <div id="zu-viele" class={newsletterAlert} role="alert">Zu viele Versuche. Bitte probier es in ein paar Minuten noch einmal.</div>
      <div id="fehler" class={newsletterAlert} role="alert">Das hat nicht geklappt. Bitte versuch es später noch einmal.</div>
      <NewsletterForm id="email-page" />
    </div>
  </section>
</Layout>
