---
// All posts with the tag filter (the Substack /archive; linked from the homepage as "Weitere Beiträge").
import Layout from '../layouts/Layout.astro';
import PostGrid from '../components/PostGrid.astro';
import NewsletterBox from '../components/ui/NewsletterBox.astro';
import { publishedPosts } from '../lib/posts';
import { site } from '../data/site';

const posts = await publishedPosts();
---
<Layout title={`Alle Beiträge | ${site.name}`} description={`Alle ${posts.length} Beiträge von ${site.author} seit ${site.firstYear}: ${site.tagline}`}>
  <PostGrid posts={posts} intro={`Alle Beiträge von ${site.author}, neueste zuerst. Filtere nach Thema oder lies einfach von oben nach unten.`} />
  <div class="container-bb pb-20 md:pb-24">
    <NewsletterBox id="email-archive" />
  </div>
</Layout>
