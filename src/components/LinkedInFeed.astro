---
// "Aktuell auf LinkedIn": the three newest entries of src/content/linkedin/posts.json as cards in
// the LinkedIn post layout (design variant A, 17.10.2026). On phones a swipe row with snap points.
// No LinkedIn embed, no tracking: the buttons link to the post on LinkedIn.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import author from '~/assets/site/author.jpg';
import Eyebrow from './ui/Eyebrow.astro';
import Stroke from './ui/Stroke.astro';
import { site } from '../data/site';
import { formatDate } from '../lib/seo';

const posts = (await getCollection('linkedin', p => !p.data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
// Labels only when the bar is wide enough for all three (container query); below that icons only.
const action = 'inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-[10px] px-3 text-[0.8125rem] font-bold whitespace-nowrap text-ink/70 transition-colors hover:bg-tint hover:text-ink';
const label = 'hidden @[24rem]:inline';
const linkedinIcon = 'M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z';
---
{posts.length > 0 && (
  <section class="border-y border-ink/8 bg-white" aria-labelledby="linkedin-title">
    <div class="container-bb section-y flex flex-col gap-7 md:gap-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="flex flex-col gap-3">
          <Eyebrow>Aktuell auf LinkedIn</Eyebrow>
          <h2 id="linkedin-title" class="headline text-h2">Kurz gedacht, <Stroke>laut gesagt</Stroke>.</h2>
          <p class="max-w-[560px] text-lead text-ink/70">Zwischen den Ausgaben schreibe ich auf LinkedIn. Die neuesten Posts, ohne Login lesbar.</p>
        </div>
        <a href={site.linkedinUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center gap-2.5 rounded-pill bg-ink px-6 text-sm font-bold whitespace-nowrap text-paper transition-colors hover:bg-accent-deep">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={linkedinIcon} /></svg>
          Auf LinkedIn folgen
        </a>
      </div>

      <ul class="-mx-[22px] flex snap-x snap-mandatory gap-3.5 overflow-x-auto px-[22px] pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:gap-6 md:overflow-visible md:px-0 md:pb-0 lg:grid-cols-3" style="-webkit-overflow-scrolling: touch">
        {posts.map(post => (
          <li class="flex w-[310px] shrink-0 snap-start md:w-auto">
            <article class="flex w-full flex-col overflow-hidden rounded-card border border-ink/10 bg-paper">
              <header class="flex items-center gap-3 px-5 pt-4.5">
                <Image src={author} alt="" width={96} height={96} class="size-12 rounded-full object-cover object-top" />
                <div class="flex min-w-0 flex-col gap-0.5">
                  <span class="text-sm font-bold">{site.author}</span>
                  <span class="truncate text-xs text-ink/60">Digital Product Leader</span>
                  <time datetime={post.data.date.toISOString()} class="text-xs text-ink/65">{formatDate(post.data.date)}</time>
                </div>
              </header>
              <p class="mt-3.5 line-clamp-6 px-5 text-[0.9375rem] leading-[1.55] whitespace-pre-line text-ink/85">{post.data.text}</p>
              <a href={post.data.url} target="_blank" rel="noopener noreferrer" class="mx-5 mt-1.5 inline-block text-[0.8125rem] font-bold text-accent-deep">… mehr anzeigen</a>
              {post.data.image ? (
                <Image src={post.data.image} alt={post.data.imageAlt} width={900} widths={[480, 900]} sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 310px" class="mt-3.5 aspect-video w-full object-cover" />
              ) : (
                <div class="mt-3.5"></div>
              )}
              <div class="@container mt-auto flex items-center justify-around border-t border-ink/8 px-2 pt-1.5 pb-2">
                <a href={post.data.url} target="_blank" rel="noopener noreferrer" class={action} aria-label="Gefällt mir auf LinkedIn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v12M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg><span class={label}>Gefällt mir</span></a>
                <a href={post.data.url} target="_blank" rel="noopener noreferrer" class={action} aria-label="Kommentieren auf LinkedIn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg><span class={label}>Kommentieren</span></a>
                <a href={post.data.url} target="_blank" rel="noopener noreferrer" class={action} aria-label="Teilen auf LinkedIn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg><span class={label}>Teilen</span></a>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
