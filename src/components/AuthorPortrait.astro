---
// Author photo (4:5) with handwritten quote sticker: homepage closing, about, work-with-me, and the
// author box under every post. The square source (1000 px) is cropped to 4:5 at build (width +
// height), so the largest width is at most 800 to stay a true 4:5 file. On phones the homepage and
// box photos are small thumbnails next to the heading, without the sticker.
import { Image } from 'astro:assets';
import { authorPhoto } from '../data/images';
import { site } from '../data/site';

interface Props {
  /** home: homepage closing (thumbnail on phones, column from md);
   *  page: about / work-with-me hero (above the fold, loads eagerly); box: author box under posts. */
  layout?: 'home' | 'page' | 'box';
  /** Placement in the parent grid. */
  class?: string;
}

const { layout = 'page', class: className } = Astro.props;

const frameLarge = 'rounded-photo shadow-[0_24px_60px_rgba(10,10,10,0.14)]';
const frameThumb = 'rounded-control shadow-[0_8px_20px_rgba(10,10,10,0.14)]';
const variant = {
  home: {
    wrap: 'w-[96px] md:w-full md:max-w-[280px] md:justify-self-end lg:max-w-[420px]',
    sizes: '(min-width: 1024px) 420px, (min-width: 768px) 280px, 96px',
    // 192/288: phone thumbnail at 2x/3x, 560: tablet at 2x, 800: desktop at 2x (true 4:5).
    widths: [192, 288, 560, 800],
    frame: `${frameThumb} md:rounded-photo md:shadow-[0_24px_60px_rgba(10,10,10,0.14)]`,
    quote: 'hidden md:block bottom-6 md:-left-6 px-4 py-2.5 text-[1.375rem] lg:bottom-8 lg:px-5 lg:py-3 lg:text-[1.625rem]',
  },
  page: {
    wrap: 'max-w-[380px] lg:justify-self-end',
    widths: [480, 760],
    // At most 380 px wide on every screen (max-w-[380px]); narrower only below that minus the gutter.
    sizes: '(min-width: 420px) 380px, calc(100vw - 32px)',
    frame: frameLarge,
    quote: 'bottom-8 -left-3 px-5 py-3 text-[1.625rem]',
  },
  box: {
    wrap: 'w-[80px] shrink-0 sm:w-[150px] md:w-[170px]',
    // 160/240: phone thumbnail at 2x/3x and 150 px at 1x, 340: 170 px at 2x.
    widths: [160, 240, 340],
    sizes: '(min-width: 768px) 170px, (min-width: 640px) 150px, 80px',
    frame: `${frameThumb} sm:rounded-photo sm:shadow-[0_12px_30px_rgba(10,10,10,0.14)]`,
    quote: 'hidden sm:block bottom-4 -left-2 px-2.5 py-1.5 text-[1rem]',
  },
}[layout];
const width = variant.widths.at(-1)!;
---

<div class:list={['relative', variant.wrap, className]}>
  <Image
    src={authorPhoto}
    alt={site.author}
    width={width}
    height={Math.round((width * 5) / 4)}
    widths={variant.widths}
    sizes={variant.sizes}
    position="top"
    loading={layout === 'page' ? 'eager' : 'lazy'}
    class:list={['aspect-[4/5] w-full object-cover object-top', variant.frame]}
  />
  <p class:list={['absolute -rotate-3 rounded-control border border-ink/10 bg-white font-hand leading-none font-semibold whitespace-nowrap text-accent-deep shadow-[0_10px_30px_rgba(10,10,10,0.12)]', variant.quote]}>Geht nicht, gibt’s nicht.</p>
</div>
