---
// Author photo with handwritten quote sticker (homepage closing, about, work-with-me).
import { Image } from 'astro:assets';
import author from '~/assets/site/author.jpg';
import { site } from '../data/site';

interface Props {
  /** Homepage closing uses a slightly larger column and image. */
  layout?: 'home' | 'page';
  loading?: 'eager' | 'lazy';
}

const { layout = 'page', loading } = Astro.props;
const home = layout === 'home';

const wrap = home ? 'relative max-w-[420px] lg:justify-self-end' : 'relative max-w-[380px] lg:justify-self-end';
const width = home ? 840 : 760;
const widths = home ? [480, 840] : [480, 760];
const sizes = home ? '(min-width: 1024px) 420px, 100vw' : '(min-width: 1024px) 380px, 100vw';
const img =
  'aspect-[4/5] w-full rounded-photo object-cover object-top shadow-[0_24px_60px_rgba(10,10,10,0.14)]';
const quote =
  'absolute bottom-8 -left-3 -rotate-3 rounded-control border border-ink/10 bg-white px-5 py-3 font-hand text-[1.625rem] leading-none font-semibold text-accent-deep shadow-[0_10px_30px_rgba(10,10,10,0.12)]';
---

<div class={wrap}>
  <Image
    src={author}
    alt={site.author}
    width={width}
    widths={widths}
    sizes={sizes}
    loading={loading}
    class={img}
  />
  <p class:list={[quote, home && 'md:-left-6']}>Geht nicht, gibt’s nicht.</p>
</div>
