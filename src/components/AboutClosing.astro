---
// Closing section of the homepage: author photo, handwritten greeting, short bio (design variant 2)
// and the newsletter sign-up as part of it, like the author box under posts (decision 22.10.2026).
// Phones: small photo next to greeting and heading, the rest below at full width. From md: text
// column left, photo right. One markup for both: the text wrapper is `display: contents` on phones,
// so its two parts sit in the parent grid; from md it is a flex column.
import Eyebrow from './ui/Eyebrow.astro';
import AuthorPortrait from './AuthorPortrait.astro';
import Stroke from './ui/Stroke.astro';
import Button from './ui/Button.astro';
import NewsletterInline from './ui/NewsletterInline.astro';
import { site } from '../data/site';
---
<section class="border-t border-ink/8">
  <div class="container-bb section-y">
    <div class="grid grid-cols-[96px_minmax(0,1fr)] items-center gap-x-4 gap-y-6 md:grid-cols-[minmax(0,1fr)_280px] md:gap-12 lg:grid-cols-[minmax(0,1fr)_420px] lg:gap-[72px]">
      <div class="contents md:flex md:flex-col md:gap-5">
        <div class="col-start-2 row-start-1 flex flex-col gap-2 md:gap-5">
          <Eyebrow class="text-[1.625rem] md:text-[2.75rem]">Hallo, ich bin Alexej.</Eyebrow>
          <h2 class="headline text-[1.25rem]/[1.2] md:text-h2">Ich schreibe über <Stroke>Produktentwicklung und KI</Stroke>, aus 20 Jahren Praxis.</h2>
        </div>
        <div class="col-span-2 row-start-2 flex flex-col gap-5">
          <p class="max-w-[600px] text-lead text-ink/72">{site.authorBio}</p>
          <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <Button href="/about" block>Mehr über mich</Button>
            <Button href={site.workWithMeUrl} variant="outline" block>Work with me</Button>
          </div>
          <NewsletterInline id="email-home" class="mt-3 max-w-[540px]" />
        </div>
      </div>
      <AuthorPortrait layout="home" class="col-start-1 row-start-1 md:col-start-2" />
    </div>
  </div>
</section>
