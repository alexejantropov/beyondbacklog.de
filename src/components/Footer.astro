---
import { site } from '../data/site';
const year = new Date().getFullYear();
const link = 'inline-flex min-h-11 min-w-11 items-center justify-center px-2.5 text-paper/80 transition-colors hover:text-paper';
---
<footer class="bg-ink text-paper/55">
  <div class="container-bb flex flex-col gap-3 py-7 md:flex-row md:items-center md:justify-between md:gap-6 md:py-6">
    <p class="text-[0.8125rem]">© {year} {site.author} · {site.location}</p>
    <nav aria-label="Rechtliches und Social">
      <ul class="-mx-2.5 flex flex-wrap items-center gap-x-2 text-[0.8125rem] md:gap-x-4">
        <li><a href={site.linkedinUrl} target="_blank" rel="noopener noreferrer" class={link}>LinkedIn</a></li>
        <li><a href="/beitraege" class={link}>Alle Beiträge</a></li>
        <li><a href="/feed.xml" class={link}>RSS</a></li>
        <li><a href="/newsletter" class={link}>Newsletter</a></li>
        <li><a href="/impressum" class={link}>Impressum</a></li>
        <li><a href="/datenschutz" class={link}>Datenschutz</a></li>
      </ul>
    </nav>
  </div>
</footer>
