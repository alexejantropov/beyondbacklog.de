---
// Posts as equal cards in three columns.
import PostCard from './ui/PostCard.astro';
import Eyebrow from './ui/Eyebrow.astro';
import { site } from '../data/site';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
  heading?: string;
  /** h1 when the grid is the page's main content (/beitraege, /ki-radar), h2 on the homepage. */
  headingLevel?: 'h1' | 'h2';
  eyebrow?: string;
  /** Show only the first n posts (homepage teaser). */
  limit?: number;
  /** The grid is the first section of the page (/beitraege): the first row of covers loads eagerly. */
  eagerFirstRow?: boolean;
  /** Link below the grid, e.g. to the full list. */
  more?: { href: string; label: string };
}
const { posts, heading = `Frisch aus dem Backlog, seit ${site.firstYear}.`, eyebrow = 'Alle Beiträge', headingLevel: Heading = 'h2', limit, eagerFirstRow = false, more } = Astro.props;
---
<section class="container-bb pt-16 pb-20 md:pt-[72px] md:pb-24">
  <div class="flex flex-col gap-3">
    <Eyebrow>{eyebrow}</Eyebrow>
    <Heading class="headline text-h2">{heading}</Heading>
  </div>
  <div class="mt-8 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
    {posts.slice(0, limit).map((post, i) => <PostCard post={post} eager={eagerFirstRow && i < 3} />)}
  </div>
  {more && (
    <div class="mt-10 flex justify-center md:mt-12">
      <a href={more.href} class="inline-flex min-h-12 items-center rounded-control border border-ink/80 px-7 text-[0.9375rem] font-bold text-ink transition-colors hover:bg-ink hover:text-paper">{more.label}</a>
    </div>
  )}
</section>

