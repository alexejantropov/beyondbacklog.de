---
// Homepage hero (design variant 3, light): eyebrow, headline with pen stroke, lead; the newest post
// as a card. Subscribing lives in the header button (decision 22.10.2026), not here.
import { Image } from 'astro:assets';
import Eyebrow from './ui/Eyebrow.astro';
import Stroke from './ui/Stroke.astro';
import { postPath, type Post } from '../lib/posts';

interface Props { latest: Post }
const { latest } = Astro.props;
---
<section class="border-b border-ink/6 bg-tint">
  <div class="container-bb section-y">
    <!-- One card for every width (one cover download): on phones it sits below the lead, on lg it
         fills the right column; the 1fr rows above and below keep the text vertically centered. -->
    <div class="flex flex-col gap-6 md:gap-7 lg:grid lg:grid-cols-[minmax(0,1.15fr)_520px] lg:grid-rows-[1fr_auto_auto_auto_1fr] lg:gap-x-[72px]">
      <Eyebrow class="lg:row-start-2">Über Innovation, Software &amp; KI</Eyebrow>
      <h1 class="headline text-display lg:row-start-3">Gedanken eines <Stroke>Digital Product Leaders</Stroke></h1>
      <p class="max-w-[560px] text-lead text-ink/72 lg:row-start-4">Hi, ich bin Alexej. Seit 2006 bin ich auf der Produktseite von Software unterwegs. Hier teile ich, was ich dabei über Produktentwicklung und KI lerne. Unregelmäßig und kostenlos.</p>
      <a href={postPath(latest)} class="group block overflow-hidden rounded-card border border-ink/10 bg-white shadow-[0_16px_40px_rgba(10,10,10,0.12)] lg:col-start-2 lg:row-span-5 lg:row-start-1 lg:max-w-[520px] lg:self-center lg:justify-self-end lg:rotate-[1.5deg] lg:rounded-box lg:shadow-[0_24px_60px_rgba(10,10,10,0.14)]">
        {latest.data.cover && <Image src={latest.data.cover} alt={latest.data.coverAlt} lang={latest.data.lang} width={1200} widths={[480, 800, 1040, 1200]} sizes="(min-width: 1024px) 520px, 100vw" loading="eager" fetchpriority="high" class="aspect-video w-full object-cover" />}
        <div class="flex flex-col gap-2 p-5 lg:gap-2.5 lg:px-7 lg:pt-6 lg:pb-7">
          <Eyebrow as="span" class="text-[1.375rem] lg:text-[1.5rem]">Im Fokus</Eyebrow>
          {latest.data.eyebrow && <p lang={latest.data.lang} class="text-meta font-bold text-ink/60 uppercase">{latest.data.eyebrow}</p>}
          <h2 lang={latest.data.lang} class="headline text-[1.375rem] leading-[1.15] tracking-[-0.02em] group-hover:text-accent-deep lg:text-[1.75rem] lg:leading-[1.12]">{latest.data.title}</h2>
          {latest.data.subtitle && <p lang={latest.data.lang} class="line-clamp-3 text-[0.9375rem] leading-relaxed text-ink/70 max-lg:hidden">{latest.data.subtitle}</p>}
          <span class="mt-1.5 text-sm font-bold underline decoration-2 underline-offset-[5px] max-lg:hidden">Lesen →</span>
        </div>
      </a>
    </div>
  </div>
</section>
