---
// Handwritten label above a headline (design decision: Caveat instead of small caps).
interface Props { as?: 'p' | 'span' | 'div'; class?: string }
const { as: Tag = 'p', class: className } = Astro.props;
---
<Tag class:list={['font-hand text-hand font-semibold text-accent-deep', className]}><slot /></Tag>
