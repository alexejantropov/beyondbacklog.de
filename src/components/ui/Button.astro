---
// Pill button rendered as a link. At least 44px high (touch target).
interface Props {
  href: string;
  variant?: 'ink' | 'accent' | 'outline' | 'link';
  size?: 'md' | 'lg';
  block?: boolean;
  class?: string;
}
const { href, variant = 'ink', size = 'md', block = false, class: className } = Astro.props;
const isExternal = /^https?:\/\//.test(href);
const variants = {
  ink: 'rounded-pill bg-ink text-paper hover:bg-accent-deep',
  accent: 'rounded-pill bg-accent text-white hover:bg-accent-deep',
  outline: 'rounded-pill border border-ink/80 text-ink hover:bg-ink hover:text-paper',
  link: 'text-ink underline decoration-2 underline-offset-[6px] hover:text-accent-deep',
};
const sizes = variant === 'link' ? 'text-sm' : size === 'lg' ? 'px-8 py-4 text-base' : 'px-6 py-3 text-sm';
---
<a href={href} class:list={['inline-flex min-h-11 items-center justify-center gap-2 text-center font-bold transition-colors', variants[variant], sizes, block && 'w-full sm:w-auto', className]} {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
  <slot />
</a>
