---
// Tinted sign-up box (posts list, KI-Radar, about, work with me; design decision 17.10.2026). The
// homepage and posts use NewsletterInline inside the author block instead.
import Eyebrow from './Eyebrow.astro';
import Stroke from './Stroke.astro';
import NewsletterForm from './NewsletterForm.astro';
import { site } from '../../data/site';
interface Props { id: string; class?: string }
const { id, class: className } = Astro.props;
---
<aside class:list={['rounded-box border border-ink/8 bg-tint p-7 md:p-11', className]} aria-labelledby={`${id}-title`}>
  <div class="grid gap-6 lg:grid-cols-2 lg:items-center lg:gap-10">
    <div class="flex flex-col gap-3">
      <Eyebrow>Newsletter</Eyebrow>
      <p id={`${id}-title`} class="headline text-[2rem] leading-[1.1] tracking-[-0.02em]">{site.newsletterClaim.start} <Stroke>{site.newsletterClaim.highlight}</Stroke>.</p>
    </div>
    <NewsletterForm id={id} />
  </div>
</aside>
