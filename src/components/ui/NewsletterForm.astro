---
// Sign-up form (double opt-in via /api/subscribe). Works without JS as a normal POST; with JS the
// result is shown in place. The hidden "website" field is a honeypot for bots.
interface Props {
  id: string;
  /** Stack input and button on every width (narrow columns). */
  stacked?: boolean;
  class?: string;
}
const { id, stacked = false, class: className } = Astro.props;
---
<form method="post" action="/api/subscribe" class:list={['flex flex-col gap-2.5', className]} data-newsletter-form novalidate>
  <div class:list={['flex gap-2.5', stacked ? 'flex-col' : 'flex-col sm:flex-row']}>
    <label for={id} class="sr-only">E-Mail-Adresse</label>
    <input id={id} type="email" name="email" required autocomplete="email" placeholder="deine@email.de" class="min-h-[52px] flex-1 rounded-control border border-ink/25 bg-white px-5 text-base text-ink placeholder:text-ink/45" />
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <button type="submit" class="min-h-[52px] rounded-control bg-accent px-7 text-base font-bold whitespace-nowrap text-white transition-colors hover:bg-accent-deep">Abonnieren</button>
  </div>
  <p class="text-[0.8125rem] text-ink/60" data-newsletter-note>
    Kein Spam, jederzeit abbestellbar. <a href="/datenschutz" class="underline underline-offset-[3px]">Datenschutz</a>
  </p>
  <p class="hidden text-sm font-semibold" role="status" aria-live="polite" data-newsletter-status></p>
</form>

<script>
  import { isValidEmail, SUBSCRIBE_MESSAGES as MSG } from '../../lib/email';

  document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach(form => {
    const status = form.querySelector<HTMLElement>('[data-newsletter-status]');
    const note = form.querySelector<HTMLElement>('[data-newsletter-note]');
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (!status || !button) return;
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      if (!isValidEmail(email)) {
        status.textContent = MSG.invalid;
        status.classList.remove('hidden');
        return;
      }
      button.disabled = true;
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({ email, website: (form.elements.namedItem('website') as HTMLInputElement).value }),
        });
        const data = await res.json().catch(() => ({}));
        status.textContent = data.message ?? (res.ok ? MSG.sent : MSG.failed);
        status.classList.remove('hidden');
        if (res.ok) {
          form.querySelector('div')?.classList.add('hidden');
          note?.classList.add('hidden');
        }
      } catch {
        status.textContent = 'Keine Verbindung. Bitte versuch es später noch einmal.';
        status.classList.remove('hidden');
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
