---
import '@fontsource-variable/open-sans/wdth.css';
import '@fontsource-variable/caveat/wght.css';
import openSansLatin from '@fontsource-variable/open-sans/files/open-sans-latin-wdth-normal.woff2?url';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import ogDefault from '~/assets/site/og-default.png';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { stripTrailingSlash, toMetaDescription } from '../lib/seo';
import { toJsonLd } from '../lib/structuredData';
import { OG_IMAGE } from '../lib/og';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Social preview image (cropped to 1200×630, src/lib/og.ts). Defaults to the logo card. */
  ogImage?: ImageMetadata;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  lang?: 'de' | 'en';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Posts: publication date for article:published_time. */
  publishedTime?: Date;
  /** Social preview alt text. */
  ogImageAlt?: string;
}

const {
  title = `${site.name} | ${site.tagline}`,
  description = site.description,
  ogImage = ogDefault,
  ogType = 'website',
  noindex = false,
  lang = 'de',
  structuredData,
  publishedTime,
  ogImageAlt,
} = Astro.props;

const metaDescription = toMetaDescription(description);
const og = await getImage({ src: ogImage, ...OG_IMAGE });
const canonicalUrl = new URL(stripTrailingSlash(Astro.url.pathname.replace(/\.html$/, '')), Astro.site).href;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafaf7" />
    <meta name="author" content={site.author} />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/feed.xml" />
    <link rel="preload" href={openSansLatin} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:image" content={new URL(og.src, Astro.site).href} />
    <meta property="og:image:width" content={String(og.attributes.width)} />
    <meta property="og:image:height" content={String(og.attributes.height)} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {publishedTime && <meta property="article:author" content={site.author} />}
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData && <script is:inline type="application/ld+json" set:html={toJsonLd(structuredData)} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
