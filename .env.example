# Copy to .env for local development. On Replit: Deployment → Secrets.
RESEND_API_KEY=re_xxx
# Segment that receives the newsletter (Resend → Contacts → Segments).
RESEND_SEGMENT_ID=
# Optional: topic shown on Resend's unsubscribe page.
RESEND_TOPIC_ID=
# Random secret (32+ chars) for signed double-opt-in links.
SUBSCRIBE_SECRET=change-me
# Sender of confirmation and newsletter mails (domain verified in Resend).
MAIL_FROM="Alexej Antropov <alexej@beyondbacklog.de>"
SITE_URL=https://www.beyondbacklog.de
# Proxies in front of the server that append to X-Forwarded-For (rate-limit key). Replit: 1.
TRUSTED_PROXY_HOPS=1
