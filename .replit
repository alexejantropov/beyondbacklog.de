# Replit: Autoscale deployment of the Astro site (Express + Node adapter, see server.mjs).
# Secrets (Deployment → Secrets): RESEND_API_KEY, RESEND_SEGMENT_ID, SUBSCRIBE_SECRET, MAIL_FROM, SITE_URL.
modules = ["nodejs-22"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "node server.mjs"]

[[ports]]
localPort = 4321
externalPort = 80

[workflows]
runButton = "Dev"

[[workflows.workflow]]
name = "Dev"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- --host 0.0.0.0 --port 4321"
waitForPort = 4321
